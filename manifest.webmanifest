{
  "id": "./",
  "name": "Jejak – Ringkasan Meeting",
  "short_name": "Jejak",
  "description": "Unggah rekaman meeting, dapat kartu ringkasan yang gampang dibaca.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F5EADF",
  "theme_color": "#F5EADF",
  "lang": "id",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./bagikan",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "rekaman",
          "accept": [
            "audio/*",
            ".m4a",
            ".mp3",
            ".ogg",
            ".opus",
            ".wav",
            ".aac",
            ".flac",
            ".webm"
          ]
        }
      ]
    }
  }
}